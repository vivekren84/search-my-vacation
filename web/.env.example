NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

JOURNEY_LEAD_NOTIFICATION_EMAILS=
JOURNEY_LEAD_FROM_EMAIL=
RESEND_API_KEY=

# EBC-R1.2-WS5-03 / DEC-R1.2-016: SMS provider (MSG91), abstracted behind
# web/lib/journey-passport-otp/sms.ts. Feature fails closed if absent.
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
# MSG91 SendOTP template id (mandatory — obtained when the India DLT template
# is registered on the MSG91 dashboard, WS5-01 §11). Without this set,
# Journey Passport OTP sending fails closed (otp_unavailable), same as a
# missing API key/sender id.
SMS_PROVIDER_TEMPLATE_ID=

# EBC-R1.2-WS5-03 §5: Journey Passport OTP configuration. All optional —
# each falls back to the documented default (see journey-passport-otp.config.ts).
JOURNEY_PASSPORT_OTP_EXPIRY_SECONDS=
JOURNEY_PASSPORT_OTP_RESEND_DELAY_SECONDS=
JOURNEY_PASSPORT_OTP_MAX_RESENDS=
JOURNEY_PASSPORT_OTP_MAX_VERIFY_ATTEMPTS=
JOURNEY_PASSPORT_OTP_RATE_LIMIT_WINDOW_SECONDS=
JOURNEY_PASSPORT_OTP_RATE_LIMIT_MAX=
JOURNEY_PASSPORT_OTP_PROVIDER_TIMEOUT_MS=
